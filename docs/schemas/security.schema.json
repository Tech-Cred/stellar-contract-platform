{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tech-Cred/stellar-contract-platform/blob/main/docs/schemas/security.schema.json",
  "title": "security report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "tool", "version", "data"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "security" },
    "tool": { "const": "stellar-contract-platform" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "findings"],
      "properties": {
        "status": { "enum": ["PASS", "WARN", "ERROR"] },
        "suppressed": {
          "type": "integer",
          "minimum": 0,
          "description": "Findings hidden by a baseline suppression. Omitted when zero."
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "severity",
              "message",
              "path",
              "experimental",
              "confidence",
              "evidence",
              "recommendation"
            ],
            "properties": {
              "id": { "type": "string" },
              "severity": { "enum": ["WARN", "ERROR"] },
              "message": {
                "type": "string",
                "description": "Non-accusatory description prefixed with 'Potential issue:'."
              },
              "path": { "type": ["string", "null"] },
              "experimental": { "type": "boolean" },
              "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": { "type": "string" },
                "description": "Bounded observations backing the potential issue."
              },
              "recommendation": {
                "type": "string",
                "description": "Non-prescriptive next step for reviewing the potential issue."
              }
            }
          }
        }
      }
    }
  }
}
