{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tech-Cred/stellar-contract-platform/blob/main/docs/schemas/fingerprint.schema.json",
  "title": "fingerprint report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "tool", "version", "data"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "fingerprint" },
    "tool": { "const": "stellar-contract-platform" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "artifact_sha256", "interface_sha256"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["sha256", "sha512"],
          "default": "sha256"
        },
        "artifact_sha256": { "type": "string" },
        "interface_sha256": { "type": ["string", "null"] }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "data": {
            "type": "object",
            "properties": { "algorithm": { "const": "sha256" } },
            "required": ["algorithm"]
          }
        },
        "required": ["data"]
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "artifact_sha256": { "$ref": "#/$defs/sha256" },
              "interface_sha256": {
                "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data": {
            "type": "object",
            "properties": { "algorithm": { "const": "sha512" } },
            "required": ["algorithm"]
          }
        },
        "required": ["data"]
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "artifact_sha256": { "$ref": "#/$defs/sha512" },
              "interface_sha256": {
                "oneOf": [{ "$ref": "#/$defs/sha512" }, { "type": "null" }]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha512": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
  }
}
