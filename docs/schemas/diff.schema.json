{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tech-Cred/stellar-contract-platform/blob/main/docs/schemas/diff.schema.json",
  "title": "diff report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "tool", "version", "data"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "diff" },
    "tool": { "const": "stellar-contract-platform" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changes", "summary"],
      "properties": {
        "changes": { "type": "array", "items": { "type": "object" } },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "breaking", "non_breaking", "informational", "by_kind"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "breaking": { "type": "integer", "minimum": 0 },
            "non_breaking": { "type": "integer", "minimum": 0 },
            "informational": { "type": "integer", "minimum": 0 },
            "by_kind": {
              "type": "object",
              "description": "Counts per change kind. Absent kinds are zero; keys follow the ChangeKind declaration order.",
              "additionalProperties": false,
              "properties": {
                "function_added": { "type": "integer", "minimum": 1 },
                "function_removed": { "type": "integer", "minimum": 1 },
                "function_changed": { "type": "integer", "minimum": 1 },
                "function_renamed": { "type": "integer", "minimum": 1 },
                "type_added": { "type": "integer", "minimum": 1 },
                "type_removed": { "type": "integer", "minimum": 1 },
                "type_changed": { "type": "integer", "minimum": 1 },
                "union_case_added": { "type": "integer", "minimum": 1 },
                "type_renamed": { "type": "integer", "minimum": 1 },
                "event_added": { "type": "integer", "minimum": 1 },
                "event_removed": { "type": "integer", "minimum": 1 },
                "event_changed": { "type": "integer", "minimum": 1 },
                "event_renamed": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
