{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tech-Cred/stellar-contract-platform/blob/main/docs/schemas/deployment.schema.json",
  "title": "deployment report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "tool", "version", "data"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "deployment" },
    "tool": { "const": "stellar-contract-platform" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "wasm_hash", "last_modified_ledger_seq", "live_until_ledger_seq", "found"],
      "properties": {
        "contract_id": { "type": "string" },
        "wasm_hash": { "type": ["string", "null"] },
        "last_modified_ledger_seq": { "type": ["integer", "null"], "minimum": 0 },
        "live_until_ledger_seq": { "type": ["integer", "null"], "minimum": 0 },
        "found": { "type": "boolean" },
        "network": {
          "type": "object",
          "description": "The resolved network profile, present when the lookup was made on a named network.",
          "additionalProperties": false,
          "required": ["network", "passphrase", "default_rpc_url"],
          "properties": {
            "network": { "enum": ["public", "testnet", "futurenet"] },
            "passphrase": { "type": "string" },
            "default_rpc_url": { "type": "string" }
          }
        },
        "storage": {
          "type": ["object", "null"],
          "description": "Bounded summary of the instance storage map. Keys and values are never included.",
          "additionalProperties": false,
          "required": ["entry_count", "inspected_entries", "truncated", "key_types", "value_types"],
          "properties": {
            "entry_count": { "type": "integer", "minimum": 0 },
            "inspected_entries": { "type": "integer", "minimum": 0 },
            "truncated": { "type": "boolean" },
            "key_types": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            },
            "value_types": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
